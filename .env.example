# Modelo de variáveis de ambiente para rodar o sistema fora da Lovable.
# Copie para ".env" e preencha com os dados do seu projeto Supabase.

# --- Banco de dados / autenticação / arquivos (visíveis no navegador) ---
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-publica"
VITE_SUPABASE_PROJECT_ID="seu-projeto"

# --- Mesmos dados, usados pelo servidor ---
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-chave-publica"

# Chave de administração: NUNCA compartilhe nem publique.
SUPABASE_SERVICE_ROLE_KEY="sua-chave-de-administracao"

# --- Conselho Operacional (IA) ---
# Qualquer provedor compatível com a API da OpenAI.
# Exemplos:
#   OpenAI      -> AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
#   OpenRouter  -> AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=google/gemini-2.5-flash
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Usado apenas dentro da Lovable; fora dela deixe vazio e preencha AI_API_KEY.
LOVABLE_API_KEY=""
